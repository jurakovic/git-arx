#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# git-arx – Branch Archive Tool for Git
# Archive local git branches that have no remote tracking branch.
# Usage: git arx <command> [options]
# =============================================================================

VERSION="dev"

# --- CONFIG HELPERS ----------------------------------------------------------

_arx_require_git() {
    # Locate the repository, setting ARX_GIT_ROOT. One rev-parse answers both
    # questions at once – whether this is a repository at all, and where its
    # root is – because starting a git process costs far more than either
    # answer.
    local out
    if ! out=$(git rev-parse --git-dir --show-toplevel 2>/dev/null); then
        # rev-parse answers argument by argument, so in a bare repository it
        # has already printed the git dir before --show-toplevel fails. Empty
        # output means it never got that far: there is no repository here.
        if [[ -n "$out" ]]; then
            printf 'git-arx: this command must run inside a work tree (not a bare repository)\n' >&2
        else
            printf 'git-arx: not inside a git repository\n' >&2
        fi
        exit 1
    fi
    ARX_GIT_ROOT="${out##*$'\n'}"   # second line: the work tree root
}

_arx_bool() {
    # Normalize a git boolean into REPLY, the way `git config --type=bool`
    # does. Assigns rather than prints: capturing output would cost the
    # subprocess this whole code path exists to avoid.
    local value="${1,,}" valueless="$2" default="$3"
    local sign literal digits cap factor magnitude limit

    # A key named with no value at all is git's implicit true; an explicitly
    # empty value is false.
    if [[ "$valueless" == "true" ]]; then
        REPLY="true"
        return 0
    fi
    case "$value" in
        true|yes|on)     REPLY="true" ;;
        false|no|off|'') REPLY="false" ;;
        *)
            # git's boolean parser falls back to its integer parser, so every
            # number is also a boolean: non-zero true, zero false. Numbers use
            # C literal rules – leading whitespace is skipped, 0x… is hex, a
            # leading 0 is octal (so 010 is 8 while 08 is not a number at all)
            # – followed by an optional k/m/g multiplier.
            if [[ ! "$value" =~ ^[[:space:]]*([-+]?)(0x[0-9a-f]+|0[0-7]*|[1-9][0-9]*)([kmg]?)$ ]]; then
                # Not a boolean at all – git itself would reject the value.
                # Fall back to the key's default rather than abort: a typo in
                # one setting should not make every command unusable.
                REPLY="$default"
                return 0
            fi
            sign="${BASH_REMATCH[1]}"
            literal="${BASH_REMATCH[2]}"
            case "${BASH_REMATCH[3]}" in
                k) factor=1024 ;;
                m) factor=$(( 1024 * 1024 )) ;;
                g) factor=$(( 1024 * 1024 * 1024 )) ;;
                *) factor=1 ;;
            esac

            # Bash arithmetic wraps at 64 bits silently, so an over-long
            # literal would evaluate to an arbitrary in-range value and pass
            # the range check below – screen it out on digit count first.
            case "$literal" in
                0x*) digits="${literal#0x}"; cap=8  ;;
                0*)  digits="$literal";      cap=11 ;;
                *)   digits="$literal";      cap=10 ;;
            esac
            if [[ "$digits" =~ ^0*([0-9a-f]+)$ ]]; then
                digits="${BASH_REMATCH[1]}"     # significant digits only
            fi
            if (( ${#digits} > cap )); then
                REPLY="$default"
                return 0
            fi

            magnitude=$(( literal ))
            limit=2147483647
            [[ "$sign" == "-" ]] && limit=2147483648

            # Divide rather than multiply: the product would overflow for the
            # very values this is meant to reject.
            if (( magnitude > limit / factor )); then
                REPLY="$default"
            elif (( magnitude != 0 )); then
                REPLY="true"
            else
                REPLY="false"
            fi
            ;;
    esac
}

_arx_load_config() {
    # Read all arx.* config once at startup – every later access is a plain
    # variable read instead of a git config subprocess per call. One
    # --get-regexp returns all four keys, so the whole of startup's config
    # handling costs a single git process.
    local storerefs="true" storefile="false" filename=".gitarchive"
    local refsprefix="refs/arx/"
    local record key value valueless
    # -z separates records with NUL and key from value with a newline, so
    # values containing spaces or newlines survive intact. A record with no
    # newline at all is a key written without a value.
    while IFS= read -r -d '' record; do
        if [[ "$record" == *$'\n'* ]]; then
            key="${record%%$'\n'*}"
            value="${record#*$'\n'}"
            valueless="false"
        else
            key="$record"
            value=""
            valueless="true"
        fi
        # Later definitions win, matching how `git config --get` resolves a key
        # set in more than one scope.
        case "$key" in
            arx.storerefs)  _arx_bool "$value" "$valueless" "true";  storerefs="$REPLY" ;;
            arx.storefile)  _arx_bool "$value" "$valueless" "false"; storefile="$REPLY" ;;
            arx.filepath)   filename="$value" ;;
            arx.refsprefix) refsprefix="$value" ;;
        esac
    done < <(git config -z --get-regexp '^arx\.' 2>/dev/null || true)

    ARX_STOREREFS="$storerefs"
    ARX_STOREFILE="$storefile"
    # Every command after this point reads or writes the archive. Checking here
    # is the only reliable place: _arx_read_all mostly runs in a process
    # substitution, where an exit ends just that subshell and leaves the
    # command to carry on – add and update would report "Archived" having
    # stored nothing.
    if [[ "$ARX_STOREREFS" != "true" && "$ARX_STOREFILE" != "true" ]]; then
        printf 'git-arx: no storage backend enabled (set arx.storerefs=true or arx.storefile=true)\n' >&2
        exit 1
    fi
    # Resolve relative to repo root, not $PWD
    ARX_FILE="${ARX_GIT_ROOT}/${filename}"
    ARX_REFSPREFIX="$refsprefix"
    # A misconfigured prefix fails silently: a ref written under a prefix that
    # `git for-each-ref <prefix>` can't match back is invisible to every read
    # (the write succeeds, listings come up empty). Enforce the documented
    # shape – must name a namespace under refs/, must end with a slash. A bare
    # "refs/" must be rejected too: it makes every listing match the entire
    # ref namespace and purge target every ref on the remote.
    if [[ "$ARX_REFSPREFIX" != refs/?* ]]; then
        printf 'git-arx: arx.refsprefix must be of the form "refs/<namespace>/" (got: "%s")\n' "$ARX_REFSPREFIX" >&2
        exit 1
    fi
    [[ "$ARX_REFSPREFIX" == */ ]] || ARX_REFSPREFIX="${ARX_REFSPREFIX}/"
    # It must also be a namespace of its own. Everything under the prefix is
    # taken to be the archive: prune deletes local branches that match an
    # entry, purge deletes every ref under it on the remote. Pointed inside
    # one of git's namespaces – refs/heads/ above all – both become mass
    # deletions, and the "archive" is the very refs being deleted.
    case "$ARX_REFSPREFIX" in
        refs/heads/*|refs/tags/*|refs/remotes/*|refs/notes/*|refs/replace/*|refs/stash/*|\
        refs/bisect/*|refs/worktree/*|refs/rewritten/*|refs/prefetch/*)
            local ns="${ARX_REFSPREFIX#refs/}"
            printf 'git-arx: arx.refsprefix must be a dedicated namespace, not inside git'"'"'s own refs/%s/ (got: "%s")\n' \
                "${ns%%/*}" "$ARX_REFSPREFIX" >&2
            exit 1
            ;;
    esac
    ARX_REMOTE_PREFIX="${ARX_REFSPREFIX%/}-remote/origin/"
}

_arx_require_storage() {
    local required="$1"
    case "$required" in
        refs)
            [[ "$ARX_STOREREFS" == "true" ]] && return 0
            printf 'git-arx: this command requires refs storage (set: git config arx.storerefs true)\n' >&2
            exit 1
            ;;
        file)
            [[ "$ARX_STOREFILE" == "true" ]] && return 0
            printf 'git-arx: this command requires file storage (set: git config arx.storefile true)\n' >&2
            exit 1
            ;;
        both)
            [[ "$ARX_STOREREFS" == "true" && "$ARX_STOREFILE" == "true" ]] && return 0
            printf 'git-arx: this command requires both storage backends (arx.storerefs and arx.storefile must both be true)\n' >&2
            exit 1
            ;;
    esac
}

# --- BACKEND: FILE -----------------------------------------------------------

_arx_is_sha() {   # value
    # A full SHA-1 or SHA-256 object name – 40 or 64 hex digits, nothing else.
    [[ ( ${#1} -eq 40 || ${#1} -eq 64 ) && "$1" != *[![:xdigit:]]* ]]
}

_arx_is_record() {   # line
    # Whether one archive file line is a record: "<name> <sha> [<date>]" with
    # a full hex SHA. Splits exactly as _arx_file_read does – $IFS plus \r,
    # so a CRLF line ending falls away.
    local name sha
    IFS=$' \t\r' read -r name sha _ <<< "$1"
    _arx_is_sha "$sha"
}

_arx_file_read() {   # [file] – default: the configured archive file
    # Emit "<name> <sha> <date>" for every record in the archive file. The
    # file is meant to be committed and shared, so its contents are untrusted
    # input: every SHA is checked here, once for all consumers, before any of
    # them reaches git – where a value like --output=<path> would be read as
    # an option, not a revision. Lines that fail the check are reported and
    # skipped.
    #
    # A line is a record by its shape, tried before the comment rule: git
    # allows branch names that start with "#", and "#hotfix <sha> <date>" is
    # such a record, while the "# git-arx archive" header – whose second word
    # is not a SHA – stays a comment.
    #
    # read splits the fields itself (as _arx_is_record does) – this loop
    # runs for every line on every read, and a regex match per line made it
    # ten times slower.
    local archive="${1:-$ARX_FILE}" name sha date n=0
    [[ -f "$archive" ]] || return 0
    while IFS=$' \t\r' read -r name sha date _ || [[ -n "$name" ]]; do
        n=$(( n + 1 ))
        if _arx_is_sha "$sha"; then
            # "-" stands in for a missing date, so the field count holds
            printf '%s %s %s\n' "$name" "${sha,,}" "${date:--}"
        elif [[ -n "$name" && "$name" != \#* ]]; then
            printf 'git-arx: %s:%d: not an archive record ("<name> <sha> <date>") – ignored\n' \
                "$archive" "$n" >&2
        fi
    done < "$archive"
}

_arx_file_apply() {
    # Apply a batch of changes to the archive file in one filter-then-append
    # rewrite. Each stdin line is "<name> <sha> <date>" to write that entry,
    # or a bare "<name>" to delete it. Every existing record for a listed
    # name is dropped – so a write replaces, and a delete removes duplicates
    # too – everything else (comments, blank lines, other records) is kept
    # verbatim, and the written records are appended.
    local archive="$ARX_FILE" tmpfile line name sha date
    local -a entries=()
    declare -A drop=()
    while IFS=' ' read -r name sha date _; do
        [[ -z "$name" ]] && continue
        drop["$name"]=1
        if [[ -n "$sha" ]]; then
            entries+=("$name $sha $date")
        fi
    done

    # Nothing to do: no input, or only deletes from a file that isn't there.
    [[ ${#drop[@]} -eq 0 ]] && return 0
    [[ ! -f "$archive" && ${#entries[@]} -eq 0 ]] && return 0

    tmpfile="${archive}.tmp.$$"
    # Create/truncate up front: the loop only appends, and if it filters out
    # every line, mv would otherwise fail on a missing tmpfile after the
    # archive was already removed.
    : > "$tmpfile"
    if [[ -f "$archive" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            # Cheap test first: only a line whose first word is a listed name
            # can be dropped, and only then is it parsed as a record.
            name="${line#"${line%%[![:space:]]*}"}"
            name="${name%%[[:space:]]*}"
            if [[ -n "${drop[$name]+x}" ]] && _arx_is_record "$line"; then
                continue
            fi
            printf '%s\n' "$line" >> "$tmpfile"
        done < "$archive"
    else
        printf '# git-arx archive – do not edit manually\n' >> "$tmpfile"
    fi
    if [[ ${#entries[@]} -gt 0 ]]; then
        printf '%s\n' "${entries[@]}" >> "$tmpfile"
    fi

    # MINGW64-safe atomic replace
    [[ -f "$archive" ]] && rm -f "$archive"
    mv "$tmpfile" "$archive"
}

_arx_file_write() {   # branch sha date
    _arx_file_apply <<< "$1 $2 $3"
}

_arx_file_write_bulk() {
    # Read "branch sha date" records from stdin and write them all in one
    # rewrite instead of one per entry.
    _arx_file_apply
}

_arx_file_delete() {   # branch
    _arx_file_apply <<< "$1"
}

# --- BACKEND: REFS -----------------------------------------------------------

_arx_refs_read() {
    # "<name> <sha> <date> <epoch>": the fourth field, the date as seconds
    # since the epoch, comes free with the same for-each-ref and saves
    # --sort=date computing it per entry. Readers that want three fields
    # absorb it into their last variable.
    local refsprefix="$ARX_REFSPREFIX"
    git for-each-ref \
        --format='%(refname) %(objectname) %(authordate:iso-strict) %(authordate:unix)' \
        "$refsprefix" \
    | while IFS=' ' read -r refname sha date epoch; do
        local branch="${refname#$refsprefix}"
        printf '%s %s %s %s\n' "$branch" "$sha" "$date" "$epoch"
    done
}

_arx_refs_write() {
    local branch="$1" sha="$2"
    git update-ref "${ARX_REFSPREFIX}${branch}" "$sha"
}

_arx_refs_write_bulk() {
    # Read "branch sha date" records from stdin and update all refs in one
    # atomic `git update-ref --stdin` transaction – a single subprocess
    # instead of one per entry. If any ref update fails, none are written.
    local branch sha rest
    while IFS=' ' read -r branch sha rest; do
        [[ -z "$branch" ]] && continue
        printf 'update %s %s\n' "${ARX_REFSPREFIX}${branch}" "$sha"
    done | git update-ref --stdin
}

_arx_refs_delete() {
    local branch="$1"
    git update-ref -d "${ARX_REFSPREFIX}${branch}" 2>/dev/null || true
}

# --- ABSTRACTION LAYER -------------------------------------------------------

_arx_read_all() {
    if [[ "$ARX_STOREREFS" == "true" && "$ARX_STOREFILE" == "true" ]]; then
        # Union merge: refs are primary; supplement with file-only entries
        declare -A seen
        while IFS=' ' read -r branch sha date rest; do
            seen["$branch"]=1
            printf '%s %s %s %s\n' "$branch" "$sha" "$date" "$rest"
        done < <(_arx_refs_read)
        while IFS=' ' read -r branch sha date rest; do
            if [[ -z "${seen[$branch]+x}" ]]; then
                printf '%s %s %s\n' "$branch" "$sha" "$date"
            fi
        done < <(_arx_file_read)
    elif [[ "$ARX_STOREREFS" == "true" ]]; then
        _arx_refs_read
    else
        _arx_file_read   # _arx_load_config guarantees at least one backend
    fi
}

_arx_write() {
    # Refs first: a ref is what keeps the commit from gc, so when it can't be
    # written (a name collision, a missing object) nothing may be recorded at
    # all – a file entry alone would tell prune the branch is safe to delete.
    # `|| return` keeps that order even where set -e is not in effect; the
    # file write stays a plain command so set -e still guards its steps.
    local branch="$1" sha="$2" date="$3"
    if [[ "$ARX_STOREREFS" == "true" ]]; then
        _arx_refs_write "$branch" "$sha" || return
    fi
    if [[ "$ARX_STOREFILE" == "true" ]]; then
        _arx_file_write "$branch" "$sha" "$date"
    fi
}

_arx_write_bulk() {
    # Read "branch sha date" records from stdin and write them to all enabled
    # backends, one bulk pass per backend – refs first, as in _arx_write. The
    # refs pass is one all-or-nothing transaction, so if it fails the file is
    # left untouched and nothing from the batch is recorded anywhere.
    local -a records=()
    local line
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        records+=("$line")
    done
    [[ ${#records[@]} -eq 0 ]] && return 0
    if [[ "$ARX_STOREREFS" == "true" ]]; then
        # Callers print their per-entry messages before this flush, so say
        # outright that none of them took effect.
        if ! printf '%s\n' "${records[@]}" | _arx_refs_write_bulk; then
            printf 'git-arx: the refs update failed, so nothing was archived (see the error above)\n' >&2
            return 1
        fi
    fi
    if [[ "$ARX_STOREFILE" == "true" ]]; then
        printf '%s\n' "${records[@]}" | _arx_file_write_bulk
    fi
}

_arx_delete() {
    local branch="$1"
    if [[ "$ARX_STOREFILE" == "true" ]]; then
        _arx_file_delete "$branch"
    fi
    if [[ "$ARX_STOREREFS" == "true" ]]; then
        _arx_refs_delete "$branch"
    fi
}

_arx_lookup_branch() {
    local branch="$1"
    _arx_read_all | while IFS=' ' read -r b sha date rest; do
        if [[ "$b" == "$branch" ]]; then
            printf '%s %s\n' "$sha" "$date"
        fi
    done
}

_arx_sha_exists() {
    local sha="$1"
    git cat-file -e "$sha" 2>/dev/null
}

_arx_require_valid_name() {   # name
    # A name chosen by the user – add's archive-name, rename's new name –
    # becomes a ref under the prefix, a branch on checkout, and a
    # whitespace-delimited field in the archive file. So it must be a valid
    # branch name: git's ref-name rules (no spaces, no "..", ...) plus no
    # leading "-". Checked before any backend is written.
    if [[ "$1" == -* ]] || ! git check-ref-format "refs/heads/$1"; then
        printf 'git-arx: "%s" is not a valid archive name (it must be a valid branch name)\n' "$1" >&2
        exit 1
    fi
}

_arx_authors_by_sha() {
    # Print "<sha> <author>" for each SHA argument that still exists.
    # --ignore-missing drops garbage-collected objects from the batch; without
    # it a single bad SHA makes `git log --no-walk <sha...>` abort with exit
    # 128 and print nothing, blanking the author for EVERY entry, not just the
    # dead one. The SHAs go in on stdin rather than as arguments: --stdin
    # mode refuses anything option-shaped, and there is no command-line
    # length limit to hit (on Windows, a few hundred SHAs).
    [[ $# -eq 0 ]] && return 0
    printf '%s\n' "$@" | git log --no-walk --ignore-missing --stdin --format='%H %an' 2>/dev/null || true
}

_arx_prune_deletable() {   # sha existing_sha existing_as live remote_gone
    # Whether prune may delete a local branch at <sha>, given the SHA archived
    # under its name and the name its commit is archived under (either may be
    # empty), and the state of its upstream – see INTERNALS (arx prune).
    [[ "$2" == "$1" ]] && return 0
    # Commit archived under another name. The second test is what separates
    # a branch that was itself archived from one that merely shares a tip
    # with an archived branch.
    [[ -n "$3" && $4 -eq 0 ]] && [[ -n "$2" || $5 -eq 1 ]]
}

_arx_epoch() {   # iso-8601-date
    # Seconds since the epoch for an ISO-8601 timestamp with a UTC offset
    # (git's iso-strict), in REPLY; 0 if it doesn't parse. The --sort=date
    # key for archive file records: stored dates keep the author's own
    # offset, so compared as text 10:00+09:00 sorts after 02:00+00:00
    # although it happened an hour earlier. The format is fixed-width, so
    # after a glob check the fields are sliced out by position, and the date
    # becomes days-from-civil in one arithmetic expression – no date(1)
    # process, and no regex, per entry.
    local t="$1" o=0
    if [[ "$t" != [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]* ]]; then
        REPLY=0
        return 0
    fi
    case "${t:19}" in
        ""|Z) ;;
        [+-][0-9][0-9]:[0-9][0-9]) o=$(( 10#${t:20:2} * 3600 + 10#${t:23:2} * 60 )) ;;
        [+-][0-9][0-9][0-9][0-9])  o=$(( 10#${t:20:2} * 3600 + 10#${t:22:2} * 60 )) ;;
        *) REPLY=0; return 0 ;;
    esac
    [[ "${t:19:1}" == "-" ]] && o=$(( -o )) || true
    # Years counted from March, so a leap day falls at the end of its year.
    local m=$(( 10#${t:5:2} ))
    local y=$(( 10#${t:0:4} - (m <= 2) ))
    if (( y < 0 )); then
        REPLY=0
        return 0
    fi
    local era=$(( y / 400 )) yoe=$(( y % 400 ))   # 400-year eras, year of era
    REPLY=$(( ( era * 146097 + yoe * 365 + yoe / 4 - yoe / 100
               + (153 * (m > 2 ? m - 3 : m + 9) + 2) / 5 + 10#${t:8:2} - 1 - 719468 ) * 86400
             + 10#${t:11:2} * 3600 + 10#${t:14:2} * 60 + 10#${t:17:2} - o ))
}

_arx_sort_keys() {   # sort_by order epoch_field
    # Build sort(1) key options for <sort_by: name|date> <order: asc|desc>
    # over rows whose field 1 is the branch name and field <epoch_field> the
    # date as seconds since the epoch (_arx_epoch) – a number, so dates with
    # different UTC offsets order by when they happened. Reverse only the
    # primary key (per-key 'r' modifier); the -k1,1 name tiebreak stays
    # ascending so same-date entries always list A->Z. A global -r would
    # reverse the tiebreak too. Keys must be bounded (-kN,N): an open -kN
    # spans to end of line and would tiebreak on trailing fields instead of
    # the branch name.
    local sort_by="$1" order="$2" field="$3" r=""
    [[ "$order" == "desc" ]] && r="r"
    if [[ "$sort_by" == "date" ]]; then
        printf '%s' "-k${field},${field}n${r} -k1,1"
    else
        printf '%s' "-k1,1${r}"
    fi
}

_arx_ls_remote() {
    # Print "<sha>\t<refname>" for every arx ref on origin, without
    # downloading objects. A non-zero ls-remote must abort, not degrade:
    # `|| true` would report an unreachable remote as "no refs". Let git's
    # own stderr through — a missing remote or an auth failure has a precise
    # diagnostic that a generic "check your network" message would
    # misattribute.
    if ! git ls-remote origin "${ARX_REFSPREFIX}*"; then
        printf 'git-arx: failed to query archived refs on origin\n' >&2
        return 1
    fi
}

# --- COMMANDS ----------------------------------------------------------------

cmd_add() {
    local branch="" archive_name="" force=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --force|-f) force=1 ;;
            --*) printf 'git-arx: unknown option "%s"\n' "$1" >&2; exit 1 ;;
            *)
                if [[ -z "$branch" ]]; then branch="$1"
                elif [[ -z "$archive_name" ]]; then archive_name="$1"
                else printf 'git-arx: unexpected argument "%s"\n' "$1" >&2; exit 1
                fi ;;
        esac
        shift
    done

    [[ -z "$branch" ]] && { printf 'Usage: git arx add <branch> [archive-name] [--force]\n' >&2; exit 1; }
    if [[ -n "$archive_name" ]]; then
        _arx_require_valid_name "$archive_name"
    fi

    if ! git rev-parse --verify "refs/heads/${branch}" > /dev/null 2>&1; then
        printf 'git-arx: branch "%s" not found in local branches\n' "$branch" >&2
        exit 1
    fi

    local sha date
    sha=$(git rev-parse "refs/heads/${branch}")
    date=$(git log -1 --format=%aI "refs/heads/${branch}")

    local store_name="${archive_name:-$branch}"

    # One pass over the archive resolves both lookups: the entry stored under
    # the target name, and any names the current SHA is already stored under.
    local existing_sha="" existing_as=""
    local b s d rest
    while IFS=' ' read -r b s d rest; do
        [[ "$b" == "$store_name" ]] && existing_sha="$s" || true
        [[ "$s" == "$sha" ]] && existing_as="${existing_as:+$existing_as }$b" || true
    done < <(_arx_read_all)

    if [[ -n "$existing_sha" ]]; then
        if [[ "$existing_sha" == "$sha" ]]; then
            printf 'Already archived: %s at %s\n' "$store_name" "${sha:0:8}"
            return 0
        fi
        if [[ $force -eq 0 ]]; then
            printf 'git-arx: conflict: "%s" is already archived at %s (current: %s)\n' \
                "$store_name" "${existing_sha:0:8}" "${sha:0:8}" >&2
            if [[ -n "$archive_name" ]]; then
                printf 'To overwrite:                  git arx add %s %s --force\n' "$branch" "$archive_name" >&2
            else
                printf 'To overwrite:                  git arx add %s --force\n' "$branch" >&2
            fi
            printf 'To archive under a new name:   git arx add %s <archive-name>\n' "$branch" >&2
            exit 1
        fi
    fi

    if [[ -n "$existing_as" ]]; then
        printf 'Note: %s is already archived as "%s"\n' "${sha:0:8}" "$existing_as"
    fi

    _arx_write "$store_name" "$sha" "$date"
    if [[ -n "$archive_name" ]]; then
        printf 'Archived: %s (as %s) at %s\n' "$branch" "$store_name" "${sha:0:8}"
    else
        printf 'Archived: %s at %s\n' "$store_name" "${sha:0:8}"
    fi
}

cmd_remove() {
    local branch="${1:-}"
    [[ -z "$branch" ]] && { printf 'Usage: git arx remove <branch>\n' >&2; exit 1; }

    local entry
    entry=$(_arx_lookup_branch "$branch")
    if [[ -z "$entry" ]]; then
        printf 'git-arx: branch "%s" not found in archive\n' "$branch" >&2
        exit 1
    fi

    _arx_delete "$branch"
    printf 'Removed: %s\n' "$branch"
}

cmd_rename() {
    local old_name="${1:-}" new_name="${2:-}"
    if [[ -z "$old_name" || -z "$new_name" ]]; then
        printf 'Usage: git arx rename <old-name> <new-name>\n' >&2; exit 1
    fi
    if [[ "$old_name" == "$new_name" ]]; then
        printf 'git-arx: old and new names are identical\n' >&2; exit 1
    fi
    _arx_require_valid_name "$new_name"

    local entry
    entry=$(_arx_lookup_branch "$old_name")
    if [[ -z "$entry" ]]; then
        printf 'git-arx: branch "%s" not found in archive\n' "$old_name" >&2
        exit 1
    fi

    local existing
    existing=$(_arx_lookup_branch "$new_name")
    if [[ -n "$existing" ]]; then
        printf 'git-arx: "%s" already exists in archive\n' "$new_name" >&2
        exit 1
    fi

    local sha date
    sha=$(printf '%s' "$entry" | awk '{print $1}')
    date=$(printf '%s' "$entry" | awk '{print $2}')

    _arx_write "$new_name" "$sha" "$date"
    _arx_delete "$old_name"
    printf 'Renamed: %s -> %s\n' "$old_name" "$new_name"
}

cmd_update() {
    local dry_run=0 force=0
    for arg in "$@"; do
        case "$arg" in
            --dry-run|-n) dry_run=1 ;;
            --force|-f)   force=1 ;;
            *) printf 'git-arx: unknown option "%s"\n' "$arg" >&2; exit 1 ;;
        esac
    done

    # Load archive once into associative arrays for O(1) lookup.
    # %(upstream) last – see INTERNALS for the IFS tab-collapsing explanation.
    declare -A arc_by_name arc_by_sha
    while IFS=' ' read -r b sha date rest; do
        arc_by_name["$b"]="$sha"
        [[ -z "${arc_by_sha[$sha]:-}" ]] && arc_by_sha["$sha"]="$b" || true
    done < <(_arx_read_all)

    # Load all refs an upstream could point to (remote-tracking refs, plus
    # local branches for branch.<name>.remote=.) in one call – replaces a
    # per-branch `git rev-parse --verify` subprocess.
    declare -A existing_refs
    while IFS= read -r ref; do
        existing_refs["$ref"]=1
    done < <(git for-each-ref --format='%(refname)' refs/heads/ refs/remotes/)

    local archived=0 conflicts=0 already_safe=0
    local -a pending=()
    while IFS=$'\t' read -r branch sha date upstream_ref; do
        branch="${branch#refs/heads/}"
        # Skip never-pushed branches (no upstream configured); only archive remote-deleted ones
        if [[ -z "$upstream_ref" ]]; then
            continue
        fi
        # Skip if upstream ref exists locally (live remote tracking branch)
        if [[ -n "${existing_refs[$upstream_ref]:-}" ]]; then
            continue
        fi

        local existing_sha existing_as
        existing_sha="${arc_by_name[$branch]:-}"
        if [[ -n "$existing_sha" ]]; then
            if [[ "$existing_sha" == "$sha" ]]; then
                continue  # already up to date
            fi
            if [[ $force -eq 0 ]]; then
                existing_as="${arc_by_sha[$sha]:-}"
                if [[ -n "$existing_as" ]]; then
                    printf 'Already safe: %s (%s archived as "%s") – skipped\n' "$branch" "${sha:0:8}" "$existing_as"
                    already_safe=$(( already_safe + 1 ))
                else
                    printf 'Conflict: %s (archived: %s, current: %s) – skipped\n' \
                        "$branch" "${existing_sha:0:8}" "${sha:0:8}"
                    conflicts=$(( conflicts + 1 ))
                fi
                continue
            fi
            pending+=("$branch $sha $date")
            arc_by_name[$branch]="$sha"
            arc_by_sha[$sha]="$branch"
            printf 'Updated: %s at %s\n' "$branch" "${sha:0:8}"
            archived=$(( archived + 1 ))
            continue
        fi

        existing_as="${arc_by_sha[$sha]:-}"
        if [[ -n "$existing_as" ]]; then
            printf 'Already safe: %s (%s archived as "%s") – skipped\n' "$branch" "${sha:0:8}" "$existing_as"
            already_safe=$(( already_safe + 1 ))
            continue
        fi

        pending+=("$branch $sha $date")
        arc_by_name[$branch]="$sha"
        arc_by_sha[$sha]="$branch"
        printf 'Archived: %s\n' "$branch"
        archived=$(( archived + 1 ))
    done < <(git for-each-ref \
        --format='%(refname)%09%(objectname)%09%(authordate:iso-strict)%09%(upstream)' \
        refs/heads/)

    # Flush all writes at once: one .gitarchive rewrite and one atomic
    # update-ref transaction instead of a full file rewrite and a subprocess
    # per branch.
    if [[ $dry_run -eq 0 && ${#pending[@]} -gt 0 ]]; then
        printf '%s\n' "${pending[@]}" | _arx_write_bulk
    fi

    printf 'Done. Archived %d branch(es)' "$archived"
    [[ $already_safe -gt 0 ]] && printf ', %d already safe (SHA archived under different name)' "$already_safe" || true
    [[ $conflicts -gt 0 ]] && printf ', %d conflict(s) skipped' "$conflicts" || true
    printf '.\n'
    [[ $dry_run -eq 1 ]] && printf '(dry run – no changes written)\n' || true
    [[ $conflicts -gt 0 ]] && exit 1 || true
}

cmd_status() {
    local sort_by="name" order="" show_all=0
    for arg in "$@"; do
        case "$arg" in
            --sort=name)  sort_by="name" ;;
            --sort=date)  sort_by="date" ;;
            --order=asc)  order="asc" ;;
            --order=desc) order="desc" ;;
            --all|-a)     show_all=1 ;;
            *) printf 'git-arx: unknown option "%s"\n' "$arg" >&2; exit 1 ;;
        esac
    done

    # Default order depends on sort key: newest-first for date, A-Z for name.
    [[ -z "$order" ]] && { [[ "$sort_by" == "date" ]] && order="desc" || order="asc"; }

    # Load entire archive once into associative arrays for O(1) lookup,
    # avoiding repeated _arx_read_all calls inside the branch loop.
    declare -A arc_by_name arc_by_sha arc_date_by_name
    while IFS=' ' read -r b sha date rest; do
        arc_by_name["$b"]="$sha"
        arc_date_by_name["$b"]="$date"
        [[ -z "${arc_by_sha[$sha]:-}" ]] && arc_by_sha["$sha"]="$b" || true
    done < <(_arx_read_all)

    # Load all refs an upstream could point to (remote-tracking refs, plus
    # local branches for branch.<name>.remote=.) in one call – replaces a
    # per-branch `git rev-parse --verify` subprocess.
    declare -A existing_refs
    while IFS= read -r ref; do
        existing_refs["$ref"]=1
    done < <(git for-each-ref --format='%(refname)' refs/heads/ refs/remotes/)

    declare -A local_branches=()
    local -a rows=()
    local row
    # Single for-each-ref call fetches SHA, date, author, and upstream for
    # all branches at once – replaces per-branch git rev-parse + git log calls.
    # NOTE: %(upstream) must be LAST. Tab is IFS whitespace, so consecutive
    # tabs collapse – a mid-format empty %(upstream) would shift all following
    # fields left. Placing it last lets bash strip the trailing tab cleanly.
    while IFS=$'\t' read -r branch sha date epoch author upstream_ref; do
        branch="${branch#refs/heads/}"
        local_branches["$branch"]=1
        # Skip if upstream ref exists locally (live remote tracking branch)
        if [[ -n "$upstream_ref" && -n "${existing_refs[$upstream_ref]:-}" ]]; then
            continue
        fi

        # Classify: remote-deleted (had upstream, now gone) vs never-pushed (no upstream)
        local is_local_only=0
        if [[ -z "$upstream_ref" ]]; then
            is_local_only=1
        fi

        # Without --all, show only remote-deleted branches
        if [[ $show_all -eq 0 && $is_local_only -eq 1 ]]; then
            continue
        fi

        local status existing_sha existing_as
        existing_sha="${arc_by_name[$branch]:-}"

        if [[ "$existing_sha" == "$sha" ]]; then
            status="Archived"
        else
            existing_as="${arc_by_sha[$sha]:-}"
            if [[ -n "$existing_as" ]]; then
                status="Archived as \"${existing_as}\""
            elif [[ -n "$existing_sha" ]]; then
                status="Conflict (archived: ${existing_sha:0:8})"
            else
                if [[ $is_local_only -eq 1 ]]; then
                    status="Local only"
                else
                    status="Not archived"
                fi
            fi
        fi

        # DATE column: "YYYY-MM-DD HH:MM:SS" – slice the offset off the
        # iso-strict timestamp and swap the ISO "T" for a space (safe in a
        # tab-delimited row). Sorting uses field 6, the epoch, instead: the
        # displayed time is the author's local one. printf -v, not $(printf):
        # no subshell per branch.
        printf -v row '%s\t%s\t%s\t%s\t%s\t%s' "$branch" "${sha:0:8}" "${date:0:10} ${date:11:8}" "$author" "$status" "$epoch"
        rows+=("$row")
    done < <(git for-each-ref \
        --format='%(refname)%09%(objectname)%09%(authordate:iso-strict)%09%(authordate:unix)%09%(authorname)%09%(upstream)' \
        refs/heads/)

    # --all: also include archived branches with no local counterpart.
    if [[ $show_all -eq 1 ]]; then
        local -a orphan_branches=() orphan_shas=()
        for arc_branch in "${!arc_by_name[@]}"; do
            if [[ -z "${local_branches[$arc_branch]:-}" ]]; then
                orphan_branches+=("$arc_branch")
                orphan_shas+=("${arc_by_name[$arc_branch]}")
            fi
        done
        if [[ ${#orphan_shas[@]} -gt 0 ]]; then
            declare -A author_by_sha=()
            while IFS=' ' read -r sha author_name; do
                author_by_sha["$sha"]="$author_name"
            done < <(_arx_authors_by_sha "${orphan_shas[@]}")
            local arc_sha arc_date arc_full_date arc_author
            for arc_branch in "${orphan_branches[@]}"; do
                arc_sha="${arc_by_name[$arc_branch]}"
                arc_full_date="${arc_date_by_name[$arc_branch]}"
                arc_date="${arc_full_date:0:10} ${arc_full_date:11:8}"
                arc_author="${author_by_sha[$arc_sha]:-"(gc)"}"
                _arx_epoch "$arc_full_date"
                printf -v row '%s\t%s\t%s\t%s\t%s\t%s' "$arc_branch" "${arc_sha:0:8}" "$arc_date" "$arc_author" "Archived" "$REPLY"
                rows+=("$row")
            done
        fi
    fi

    if [[ ${#rows[@]} -eq 0 ]]; then
        if [[ $show_all -eq 0 ]]; then
            printf 'No local branches with a deleted remote.\n'
        else
            printf 'No local branches without a remote upstream.\n'
        fi
        return 0
    fi

    local sort_keys
    sort_keys=$(_arx_sort_keys "$sort_by" "$order" 6)

    local C_RED='' C_GREEN='' C_CYAN='' C_YELLOW='' C_DIM='' C_RESET=''
    if [[ -t 1 ]]; then
        C_RED=$'\033[31m' C_GREEN=$'\033[32m' C_CYAN=$'\033[96m'
        C_YELLOW=$'\033[33m' C_DIM=$'\033[2m' C_RESET=$'\033[0m'
    fi

    # Show REMOTE column in --all mode when refs backend is active
    local show_remote=0
    declare -A remote_sha_by_branch=()
    if [[ $show_all -eq 1 ]]; then
        if [[ "$ARX_STOREREFS" == "true" ]]; then
            show_remote=1
            local remote_prefix="$ARX_REMOTE_PREFIX"
            while IFS=' ' read -r refname sha _rest; do
                remote_sha_by_branch["${refname#"$remote_prefix"}"]="$sha"
            done < <(git for-each-ref --format='%(refname) %(objectname)' "$remote_prefix" 2>/dev/null || true)
        fi
    fi

    if [[ $show_remote -eq 1 ]]; then
        printf '%-40s %-9s %-21s %-20s %-30s %s\n' "BRANCH" "SHA" "DATE" "AUTHOR" "STATUS" "REMOTE"
        printf '%-40s %-9s %-21s %-20s %-30s %s\n' "------" "---" "----" "------" "------" "------"
    else
        printf '%-40s %-9s %-21s %-20s %s\n' "BRANCH" "SHA" "DATE" "AUTHOR" "STATUS"
        printf '%-40s %-9s %-21s %-20s %s\n' "------" "---" "----" "------" "------"
    fi
    local b s d a st aw saved_lc ac bc colored_st remote_st sw sc scb
    # shellcheck disable=SC2086
    while IFS=$'\t' read -r b s d a st _; do
        # %-20s pads by bytes; correct for multibyte chars in author names.
        ac=${#a}; saved_lc="${LC_ALL:-}"; LC_ALL=C; bc=${#a}; LC_ALL="$saved_lc"
        aw=$(( 20 + bc - ac ))
        case "$st" in
            "Not archived")  colored_st="${C_RED}${st}${C_RESET}" ;;
            "Archived")      colored_st="${C_GREEN}${st}${C_RESET}" ;;
            Archived\ as\ *) colored_st="${C_CYAN}${st}${C_RESET}" ;;
            Conflict*)       colored_st="${C_YELLOW}${st}${C_RESET}" ;;
            "Local only")    colored_st="${C_DIM}${st}${C_RESET}" ;;
            *)               colored_st="$st" ;;
        esac
        if [[ $show_remote -eq 1 ]]; then
            # Correct STATUS field width for invisible color-code bytes
            sc=${#st}; LC_ALL=C; scb=${#colored_st}; LC_ALL="$saved_lc"
            sw=$(( 30 + scb - sc ))
            local arc_sha_full="${arc_by_name[$b]:-}"
            local r_sha="${remote_sha_by_branch[$b]:-}"
            if [[ -z "$arc_sha_full" && -n "$r_sha" ]]; then
                remote_st="${C_CYAN}remote${C_RESET}"
            elif [[ -z "$arc_sha_full" ]]; then
                remote_st="${C_DIM}-${C_RESET}"
            elif [[ -z "$r_sha" ]]; then
                remote_st="${C_RED}local${C_RESET}"
            elif [[ "$r_sha" == "$arc_sha_full" ]]; then
                remote_st="${C_GREEN}pushed${C_RESET}"
            else
                remote_st="${C_YELLOW}ahead${C_RESET}"
            fi
            printf "%-40s %-9s %-21s %-${aw}s %-${sw}s %s\n" "$b" "$s" "$d" "$a" "$colored_st" "$remote_st"
        else
            printf "%-40s %-9s %-21s %-${aw}s %s\n" "$b" "$s" "$d" "$a" "$colored_st"
        fi
    done < <(printf '%s\n' "${rows[@]}" | sort -t$'\t' $sort_keys)
}

cmd_list() {
    local sort_by="date" order="" list_storage="" show_author=0

    for arg in "$@"; do
        case "$arg" in
            --sort=name)  sort_by="name" ;;
            --sort=date)  sort_by="date" ;;
            --order=asc)  order="asc" ;;
            --order=desc) order="desc" ;;
            --author)     show_author=1 ;;
            --storage=file|--storage=refs)
                list_storage="${arg#--storage=}" ;;
            --storage=*)
                printf 'git-arx: invalid --storage value "%s" (use: file, refs)\n' "${arg#--storage=}" >&2
                exit 1 ;;
            *) printf 'git-arx: unknown option "%s"\n' "$arg" >&2; exit 1 ;;
        esac
    done

    # Default order depends on sort key: newest-first for date, A-Z for name.
    [[ -z "$order" ]] && { [[ "$sort_by" == "date" ]] && order="desc" || order="asc"; }

    # Validate that the requested backend is available in the current storage config
    if [[ -n "$list_storage" ]]; then
        _arx_require_storage "$list_storage"
    fi

    local entries
    case "$list_storage" in
        file) entries=$(_arx_file_read) ;;
        refs) entries=$(_arx_refs_read) ;;
        *)    entries=$(_arx_read_all) ;;
    esac

    if [[ -z "$entries" ]]; then
        printf 'No archived branches.\n'
        return 0
    fi

    local sort_keys
    sort_keys=$(_arx_sort_keys "$sort_by" "$order" 4)

    # Sorting by date compares field 4, the date as seconds since the epoch:
    # refs entries already carry it, file records get it from _arx_epoch –
    # so the pass is needed only when the file contributes entries. The
    # print loop below reads the field into "rest" and ignores it.
    if [[ "$sort_by" == "date" && "$ARX_STOREFILE" == "true" && "$list_storage" != "refs" ]]; then
        local keyed="" b s d e
        while IFS=' ' read -r b s d e _; do
            if [[ -z "$e" ]]; then
                _arx_epoch "$d"
                e="$REPLY"
            fi
            keyed+="$b $s $d $e"$'\n'
        done <<< "$entries"
        entries="${keyed%$'\n'}"
    fi

    # shellcheck disable=SC2086
    local sorted
    sorted=$(printf '%s\n' "$entries" | sort $sort_keys)

    # For --author, fetch all authors in one git log call instead of per-entry.
    declare -A author_by_sha
    if [[ $show_author -eq 1 ]]; then
        local -a all_shas=()
        while IFS=' ' read -r _b sha _rest; do
            all_shas+=("$sha")
        done <<< "$sorted"
        if [[ ${#all_shas[@]} -gt 0 ]]; then
            while IFS=' ' read -r sha author_name; do
                author_by_sha["$sha"]="$author_name"
            done < <(_arx_authors_by_sha "${all_shas[@]}")
        fi
    fi

    local C_RED='' C_GREEN='' C_YELLOW='' C_RESET=''
    if [[ -t 1 ]]; then
        C_RED=$'\033[31m' C_GREEN=$'\033[32m' C_YELLOW=$'\033[33m' C_RESET=$'\033[0m'
    fi

    # Show REMOTE column when refs backend is active (not when filtered to file-only)
    local show_remote=0
    if [[ "$ARX_STOREREFS" == "true" && "$list_storage" != "file" ]]; then
        show_remote=1
    fi

    # Load remote tracking refs for REMOTE column
    declare -A remote_sha_map=()
    if [[ $show_remote -eq 1 ]]; then
        local remote_prefix="$ARX_REMOTE_PREFIX"
        while IFS=' ' read -r refname sha _rest; do
            remote_sha_map["${refname#"$remote_prefix"}"]="$sha"
        done < <(git for-each-ref --format='%(refname) %(objectname)' "$remote_prefix" 2>/dev/null || true)
    fi

    # Print header and table
    if [[ $show_author -eq 1 && $show_remote -eq 1 ]]; then
        printf '%-40s %-9s %-21s %-20s %s\n' "BRANCH" "SHA" "DATE" "AUTHOR" "REMOTE"
        printf '%-40s %-9s %-21s %-20s %s\n' "------" "---" "----" "------" "------"
    elif [[ $show_author -eq 1 ]]; then
        printf '%-40s %-9s %-21s %s\n' "BRANCH" "SHA" "DATE" "AUTHOR"
        printf '%-40s %-9s %-21s %s\n' "------" "---" "----" "------"
    elif [[ $show_remote -eq 1 ]]; then
        printf '%-40s %-9s %-21s %s\n' "BRANCH" "SHA" "DATE" "REMOTE"
        printf '%-40s %-9s %-21s %s\n' "------" "---" "----" "------"
    else
        printf '%-40s %-9s %s\n' "BRANCH" "SHA" "DATE"
        printf '%-40s %-9s %s\n' "------" "---" "----"
    fi
    while IFS=' ' read -r branch sha date rest; do
        local remote_st=""
        if [[ $show_remote -eq 1 ]]; then
            local r_sha="${remote_sha_map[$branch]:-}"
            if [[ -z "$r_sha" ]]; then
                remote_st="${C_RED}local${C_RESET}"
            elif [[ "$r_sha" == "$sha" ]]; then
                remote_st="${C_GREEN}pushed${C_RESET}"
            else
                remote_st="${C_YELLOW}ahead${C_RESET}"
            fi
        fi
        if [[ $show_author -eq 1 && $show_remote -eq 1 ]]; then
            printf '%-40s %-9s %-21s %-20s %s\n' "$branch" "${sha:0:8}" "${date:0:10} ${date:11:8}" "${author_by_sha[$sha]:-(gc)}" "$remote_st"
        elif [[ $show_author -eq 1 ]]; then
            printf '%-40s %-9s %-21s %s\n' "$branch" "${sha:0:8}" "${date:0:10} ${date:11:8}" "${author_by_sha[$sha]:-(gc)}"
        elif [[ $show_remote -eq 1 ]]; then
            printf '%-40s %-9s %-21s %s\n' "$branch" "${sha:0:8}" "${date:0:10} ${date:11:8}" "$remote_st"
        else
            printf '%-40s %-9s %s\n' "$branch" "${sha:0:8}" "${date:0:10} ${date:11:8}"
        fi
    done <<< "$sorted"
}

cmd_log() {
    local branch="${1:-}"
    [[ -z "$branch" ]] && { printf 'Usage: git arx log <branch> [git-log-options...]\n' >&2; exit 1; }
    shift  # remove branch name; remaining "$@" are git log flags

    local entry
    entry=$(_arx_lookup_branch "$branch")
    if [[ -z "$entry" ]]; then
        printf 'git-arx: branch "%s" not found in archive\n' "$branch" >&2
        exit 1
    fi

    local sha
    sha=$(printf '%s' "$entry" | awk '{print $1}')

    if ! _arx_sha_exists "$sha"; then
        printf 'git-arx: WARNING: SHA %s for branch "%s" appears to have been garbage collected.\n' "${sha:0:8}" "$branch" >&2
        printf 'The commit history is no longer available. You can remove it with: git arx remove %s\n' "$branch" >&2
        exit 1
    fi

    git log "$sha" "$@"
}

cmd_checkout() {
    local branch="${1:-}"
    [[ -z "$branch" ]] && { printf 'Usage: git arx checkout <branch>\n' >&2; exit 1; }

    local entry
    entry=$(_arx_lookup_branch "$branch")
    if [[ -z "$entry" ]]; then
        printf 'git-arx: branch "%s" not found in archive\n' "$branch" >&2
        exit 1
    fi

    local sha
    sha=$(printf '%s' "$entry" | awk '{print $1}')

    if ! _arx_sha_exists "$sha"; then
        printf 'git-arx: WARNING: SHA %s for branch "%s" appears to have been garbage collected.\n' "${sha:0:8}" "$branch" >&2
        printf 'The branch cannot be restored. You can remove it with: git arx remove %s\n' "$branch" >&2
        exit 1
    fi

    if git rev-parse --verify "refs/heads/${branch}" > /dev/null 2>&1; then
        printf 'git-arx: a local branch named "%s" already exists\n' "$branch" >&2
        exit 1
    fi

    git checkout -b "$branch" "$sha"
    printf 'Restored branch: %s at %s\n' "$branch" "${sha:0:8}"
}

cmd_merge() {
    _arx_require_storage file

    local file1="" file2="" output=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -o) shift; output="${1:-}" ;;
            *)
                if [[ -z "$file1" ]]; then file1="$1"
                elif [[ -z "$file2" ]]; then file2="$1"
                else printf 'git-arx: unexpected argument "%s"\n' "$1" >&2; exit 1
                fi
                ;;
        esac
        shift
    done

    [[ -z "$file1" || -z "$file2" || -z "$output" ]] && {
        printf 'Usage: git arx merge <file1> <file2> -o <output>\n' >&2; exit 1
    }
    [[ -f "$file1" ]] || { printf 'git-arx: file not found: %s\n' "$file1" >&2; exit 1; }
    [[ -f "$file2" ]] || { printf 'git-arx: file not found: %s\n' "$file2" >&2; exit 1; }

    # Read both through _arx_file_read, as the archive itself is read: the
    # same validation and comment rules, and a last line without a trailing
    # newline is still a record.
    declare -A map1 map2
    local branch sha date

    while IFS=' ' read -r branch sha date; do
        map1["$branch"]="$sha $date"
    done < <(_arx_file_read "$file1")

    while IFS=' ' read -r branch sha date; do
        map2["$branch"]="$sha $date"
    done < <(_arx_file_read "$file2")

    local merged=0 conflicts=0
    local tmpfile="${output}.tmp.$$"
    printf '# git-arx archive – merged from %s and %s\n' "$file1" "$file2" > "$tmpfile"

    # Collect all branch names
    declare -A all_branches
    for b in "${!map1[@]}" "${!map2[@]}"; do all_branches["$b"]=1; done

    for b in "${!all_branches[@]}"; do
        local v1="${map1[$b]+${map1[$b]}}"
        local v2="${map2[$b]+${map2[$b]}}"
        if [[ -n "$v1" && -n "$v2" ]]; then
            local s1="${v1%% *}" s2="${v2%% *}"
            if [[ "$s1" == "$s2" ]]; then
                printf '%s %s\n' "$b" "$v1" >> "$tmpfile"
                merged=$(( merged + 1 ))
            else
                printf 'CONFLICT: %s has different SHAs (%s vs %s) – skipped\n' "$b" "${s1:0:8}" "${s2:0:8}" >&2
                conflicts=$(( conflicts + 1 ))
            fi
        elif [[ -n "$v1" ]]; then
            printf '%s %s\n' "$b" "$v1" >> "$tmpfile"
            merged=$(( merged + 1 ))
        else
            printf '%s %s\n' "$b" "$v2" >> "$tmpfile"
            merged=$(( merged + 1 ))
        fi
    done

    [[ -f "$output" ]] && rm -f "$output"
    mv "$tmpfile" "$output"
    printf 'Merged %d entries to %s' "$merged" "$output"
    [[ $conflicts -gt 0 ]] && printf ' (%d conflict(s) skipped)' "$conflicts" || true
    printf '\n'
    # Skipped entries are missing from the output – exit non-zero, as update,
    # prune and sync do for conflicts.
    [[ $conflicts -gt 0 ]] && exit 1 || true
}

cmd_sync() {
    _arx_require_storage both

    local dry_run=0 force=""
    for arg in "$@"; do
        case "$arg" in
            --dry-run|-n)  dry_run=1 ;;
            --force-file)  force="file" ;;
            --force-refs)  force="refs" ;;
            *) printf 'git-arx: unknown sync option "%s"\n' "$arg" >&2; exit 1 ;;
        esac
    done

    declare -A refs_map=() file_map=()
    local branch sha date

    while IFS=' ' read -r branch sha date rest; do
        refs_map["$branch"]="$sha $date"
    done < <(_arx_refs_read)

    while IFS=' ' read -r branch sha date rest; do
        file_map["$branch"]="$sha $date"
    done < <(_arx_file_read)

    declare -A all_branches
    for b in "${!refs_map[@]}" "${!file_map[@]}"; do all_branches["$b"]=1; done

    # A ref can only point at an object the repository has, and the file may
    # name commits this clone never fetched (it travels with the repo). Check
    # every file SHA in one cat-file call up front, so such an entry is
    # skipped and reported instead of aborting the sync halfway through.
    declare -A have_object=()
    if [[ ${#file_map[@]} -gt 0 ]]; then
        local type
        while IFS=' ' read -r sha type; do
            [[ "$type" != "missing" ]] && have_object["$sha"]=1 || true
        done < <(for b in "${!file_map[@]}"; do printf '%s\n' "${file_map[$b]%% *}"; done \
            | git cat-file --batch-check='%(objectname) %(objecttype)')
    fi

    # Decide every entry first, collecting the writes into one update-ref
    # transaction and one file rewrite – applied refs first, as _arx_write
    # does – instead of a subprocess or a full file rewrite per entry.
    local had_conflict=0
    local -a ref_ops=() file_ops=()

    for b in "${!all_branches[@]}"; do
        local rv="${refs_map[$b]+${refs_map[$b]}}"
        local fv="${file_map[$b]+${file_map[$b]}}"

        if [[ -n "$rv" && -n "$fv" ]]; then
            local rs="${rv%% *}" fs="${fv%% *}"
            if [[ "$rs" == "$fs" ]]; then
                : # in sync
            else
                if [[ -n "$force" ]]; then
                    if [[ "$force" == "file" ]]; then
                        if [[ -z "${have_object[$fs]:-}" ]]; then
                            printf 'Skipped: %s – commit %s is not in this repository\n' "$b" "${fs:0:8}" >&2
                            had_conflict=1
                            continue
                        fi
                        ref_ops+=("update ${ARX_REFSPREFIX}${b} ${fs}")
                        printf 'Resolved (force-file): %s -> refs=%s\n' "$b" "${fs:0:8}"
                    else
                        file_ops+=("$b $rv")
                        printf 'Resolved (force-refs): %s -> file=%s\n' "$b" "${rs:0:8}"
                    fi
                else
                    printf 'CONFLICT: %s – refs=%s file=%s. Use --force-refs or --force-file.\n' \
                        "$b" "${rs:0:8}" "${fs:0:8}" >&2
                    had_conflict=1
                fi
            fi
        elif [[ -n "$rv" ]]; then
            if [[ "$force" == "file" ]]; then
                # File is authoritative – entry absent from file means remove it from refs
                ref_ops+=("delete ${ARX_REFSPREFIX}${b}")
                printf 'Removed from refs (force-file): %s\n' "$b"
            else
                file_ops+=("$b $rv")
                printf 'Synced to file: %s\n' "$b"
            fi
        else
            local fsha="${fv%% *}"
            if [[ "$force" == "refs" ]]; then
                # Refs is authoritative – entry absent from refs means remove it from file
                file_ops+=("$b")
                printf 'Removed from file (force-refs): %s\n' "$b"
            elif [[ -z "${have_object[$fsha]:-}" ]]; then
                printf 'Skipped: %s – commit %s is not in this repository\n' "$b" "${fsha:0:8}" >&2
                had_conflict=1
            else
                ref_ops+=("update ${ARX_REFSPREFIX}${b} ${fsha}")
                printf 'Synced to refs: %s\n' "$b"
            fi
        fi
    done

    if [[ $dry_run -eq 0 ]]; then
        if [[ ${#ref_ops[@]} -gt 0 ]]; then
            if ! printf '%s\n' "${ref_ops[@]}" | git update-ref --stdin; then
                printf 'git-arx: the refs update failed, so nothing was synced (see the error above)\n' >&2
                exit 1
            fi
        fi
        if [[ ${#file_ops[@]} -gt 0 ]]; then
            printf '%s\n' "${file_ops[@]}" | _arx_file_apply
        fi
    fi

    [[ $had_conflict -eq 1 ]] && exit 1
    printf 'Sync complete.\n'
    [[ $dry_run -eq 1 ]] && printf '(dry run – no changes written)\n' || true
}

cmd_prune() {
    local force=0 dry_run=0
    for arg in "$@"; do
        case "$arg" in
            --force|-f)   force=1 ;;
            --dry-run|-n) dry_run=1 ;;
            *) printf 'git-arx: unknown option "%s"\n' "$arg" >&2; exit 1 ;;
        esac
    done

    # Load archive once into associative arrays for O(1) lookup.
    declare -A arc_by_name arc_by_sha
    local b asha adate rest
    while IFS=' ' read -r b asha adate rest; do
        arc_by_name["$b"]="$asha"
        [[ -z "${arc_by_sha[$asha]:-}" ]] && arc_by_sha["$asha"]="$b" || true
    done < <(_arx_read_all)

    # With both backends on, the union above decides what is archived, but
    # only refs decide what may be deleted: a ref is what keeps the commit
    # from gc once its branch is gone. An entry found only in the file – a
    # drift `sync` repairs, or entries from a teammate's committed archive
    # file – is reported instead of trusted.
    local both=0
    declare -A ref_by_name=() ref_by_sha=()
    if [[ "$ARX_STOREREFS" == "true" && "$ARX_STOREFILE" == "true" ]]; then
        both=1
        while IFS=' ' read -r b asha adate rest; do
            ref_by_name["$b"]="$asha"
            [[ -z "${ref_by_sha[$asha]:-}" ]] && ref_by_sha["$asha"]="$b" || true
        done < <(_arx_refs_read)
    fi

    # Load all refs an upstream could point to (remote-tracking refs, plus
    # local branches for branch.<name>.remote=.) in one call – replaces a
    # per-branch `git rev-parse --verify` subprocess.
    declare -A existing_refs
    while IFS= read -r ref; do
        existing_refs["$ref"]=1
    done < <(git for-each-ref --format='%(refname)' refs/heads/ refs/remotes/)

    # Walk local branches, classifying each by the SHA it points at now.
    # Fields are separated by \x1f, not tab: %(upstream) and %(worktreepath)
    # can both be empty, and a run of IFS-whitespace tabs would collapse into
    # one separator and shift the fields (see INTERNALS).
    local -a branches=() labels=() skipped=() conflicts=() unprotected=()
    local branch sha upstream_ref worktree existing_sha existing_as label kind remote_gone live
    while IFS=$'\x1f' read -r branch sha upstream_ref worktree; do
        branch="${branch#refs/heads/}"
        existing_sha="${arc_by_name[$branch]:-}"   # this name, at any SHA
        existing_as="${arc_by_sha[$sha]:-}"        # this commit, under any name
        # Upstream states, as in `status`: absent (never pushed), resolvable
        # (live remote branch), or configured but gone (remote deleted).
        remote_gone=0 live=0
        if [[ -n "$upstream_ref" ]]; then
            [[ -n "${existing_refs[$upstream_ref]:-}" ]] && live=1 || remote_gone=1
        fi

        kind="" label="$branch"
        if _arx_prune_deletable "$sha" "$existing_sha" "$existing_as" "$live" "$remote_gone"; then
            kind="delete"
            if [[ "$existing_sha" != "$sha" ]]; then
                label="$branch (archived as \"$existing_as\")"
            fi
            if [[ $both -eq 1 ]] && ! _arx_prune_deletable "$sha" \
                "${ref_by_name[$branch]:-}" "${ref_by_sha[$sha]:-}" "$live" "$remote_gone"; then
                kind="unprotected"   # only the file has it
            fi
        elif [[ -n "$existing_sha" && $live -eq 0 ]]; then
            # Name is archived but this commit is in no entry at all.
            kind="conflict"
        fi
        if [[ -z "$kind" ]]; then
            continue  # not archived – leave it alone
        fi
        # git refuses to delete a branch checked out in any worktree – this
        # one or another – so it is reported as skipped rather than queued for
        # deletion or flagged as a conflict.
        if [[ -n "$worktree" ]]; then
            [[ "$worktree" != "$ARX_GIT_ROOT" ]] && label="$label (in $worktree)" || true
            skipped+=("$label")
            continue
        fi
        if [[ "$kind" == "conflict" ]]; then
            conflicts+=("$branch (archived: ${existing_sha:0:8}, current: ${sha:0:8})")
            continue
        fi
        if [[ "$kind" == "unprotected" ]]; then
            unprotected+=("$label")
            continue
        fi
        branches+=("$branch")
        labels+=("$label")
    done < <(git for-each-ref \
        --format='%(refname)%1f%(objectname)%1f%(upstream)%1f%(worktreepath)' refs/heads/)

    # Conflicts and file-only entries both need the user's attention before
    # they can be pruned, so either makes the run exit non-zero.
    local held=$(( ${#conflicts[@]} + ${#unprotected[@]} ))

    if [[ ${#branches[@]} -eq 0 && ${#skipped[@]} -eq 0 && $held -eq 0 ]]; then
        printf 'No archived branches found in local branches.\n'
        [[ $dry_run -eq 1 ]] && printf '(dry run – no changes written)\n' || true
        return 0
    fi

    if [[ ${#branches[@]} -gt 0 ]]; then
        printf 'The following local branches will be permanently deleted:\n'
        printf '  %s\n' "${labels[@]}"
        printf '\n'
    fi

    if [[ ${#skipped[@]} -gt 0 ]]; then
        printf 'Skipped (currently checked out):\n'
        printf '  %s\n' "${skipped[@]}"
        printf '\n'
    fi

    if [[ ${#conflicts[@]} -gt 0 ]]; then
        printf 'Skipped (archived at a different SHA – re-archive with "git arx add <branch> --force"):\n'
        printf '  %s\n' "${conflicts[@]}"
        printf '\n'
    fi

    if [[ ${#unprotected[@]} -gt 0 ]]; then
        printf 'Skipped (archived in the file only, no ref protects the commit – run "git arx sync", then prune again):\n'
        printf '  %s\n' "${unprotected[@]}"
        printf '\n'
    fi

    if [[ ${#branches[@]} -eq 0 ]]; then
        printf 'Nothing to delete.\n'
        [[ $dry_run -eq 1 ]] && printf '(dry run – no changes written)\n' || true
        [[ $held -gt 0 ]] && exit 1 || true
        return 0
    fi

    if [[ $dry_run -eq 0 ]]; then
        if [[ $force -eq 0 ]]; then
            printf 'WARNING: This is a dangerous operation. Deleted branches cannot be\n'
            printf 'recovered from git – only from the git-arx archive.\n'
            printf 'Type "yes" to continue: '
            local answer
            read -r answer || true
            if [[ "$answer" != "yes" ]]; then
                printf 'Aborted.\n'
                exit 1
            fi
        fi
        # One git branch -D call for the whole batch – git itself prints the
        # per-branch "Deleted branch ... (was ...)." lines.
        git branch -D "${branches[@]}"
    fi

    printf 'Done. Deleted %d branch(es)' "${#branches[@]}"
    [[ ${#conflicts[@]} -gt 0 ]] && printf ', %d conflict(s) skipped' "${#conflicts[@]}" || true
    [[ ${#unprotected[@]} -gt 0 ]] && printf ', %d not protected by a ref skipped' "${#unprotected[@]}" || true
    printf '.\n'
    [[ $dry_run -eq 1 ]] && printf '(dry run – no changes written)\n' || true
    [[ $held -gt 0 ]] && exit 1 || true
}

cmd_push() {
    _arx_require_storage refs
    local dry_run="" force="" prune=0 delete_branch=""
    local refsprefix="$ARX_REFSPREFIX" remote_prefix="$ARX_REMOTE_PREFIX"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run|-n) dry_run="--dry-run" ;;
            --force|-f)   force="--force" ;;
            --prune)      prune=1 ;;
            --delete|-d)
                shift
                [[ -z "${1:-}" ]] && { printf 'git-arx: --delete requires a branch name\n' >&2; exit 1; }
                delete_branch="$1"
                ;;
            *) printf 'git-arx: unknown option "%s"\n' "$1" >&2; exit 1 ;;
        esac
        shift
    done

    if [[ -n "$delete_branch" ]]; then
        git push $dry_run origin --delete "${refsprefix}${delete_branch}"
        if [[ -z "$dry_run" ]]; then
            git update-ref -d "${remote_prefix}${delete_branch}" 2>/dev/null || true
        fi
        return
    fi

    # Local archive refs (what gets pushed) and tracking refs (what the
    # remote held at the last push or pull), from one for-each-ref.
    declare -A local_sha=() tracked=()
    local refname sha
    while IFS=' ' read -r refname sha; do
        if [[ "$refname" == "$remote_prefix"* ]]; then
            tracked["${refname#"$remote_prefix"}"]=1
        else
            local_sha["${refname#"$refsprefix"}"]="$sha"
        fi
    done < <(git for-each-ref --format='%(refname) %(objectname)' "$refsprefix" "$remote_prefix")

    # --porcelain reports every ref's outcome, so the tracking refs follow
    # what the remote actually accepted. A push can succeed for some refs and
    # be rejected for others (a ref re-archived at a commit that doesn't
    # descend from the remote's); updating tracking only after a fully
    # successful push left the accepted ones showing as "local". git's own
    # hints about rejected refs suggest `git pull`, which is wrong here, so
    # they are turned off and replaced by ours.
    local -a args=(--porcelain)
    [[ -n "$dry_run" ]] && args+=(--dry-run) || true
    [[ -n "$force" ]] && args+=(--force) || true
    [[ $prune -eq 1 ]] && args+=(--prune) || true
    local out rc=0
    out=$(git -c advice.pushUpdateRejected=false push "${args[@]}" origin "${refsprefix}*:${refsprefix}*") || rc=$?

    # Porcelain lines are "<flag>\t<from>:<to>\t<summary>": " " fast-forward,
    # "+" forced, "*" new, "=" up to date, "-" deleted, "!" rejected.
    declare -A track_op=()
    local flag spec summary name reason pushed=0 deleted=0 rejected=0 diverged=0
    while IFS=$'\t' read -r flag spec summary; do
        [[ -z "$spec" ]] && continue   # the "To <url>" and "Done" lines
        name="${spec##*:}"
        name="${name#"$refsprefix"}"
        case "$flag" in
            '*'|' '|'+'|'=')
                case "$flag" in
                    '*') printf 'Pushed: %s (new)\n' "$name" ;;
                    ' ') printf 'Pushed: %s\n' "$name" ;;
                    '+') printf 'Pushed: %s (forced)\n' "$name" ;;
                esac
                [[ "$flag" != "=" ]] && pushed=$(( pushed + 1 )) || true
                if [[ -n "${local_sha[$name]:-}" ]]; then
                    track_op["$name"]="update ${remote_prefix}${name} ${local_sha[$name]}"
                fi
                ;;
            '-')
                printf 'Deleted from remote: %s\n' "$name"
                deleted=$(( deleted + 1 ))
                if [[ -n "${tracked[$name]:-}" ]]; then
                    track_op["$name"]="delete ${remote_prefix}${name}"
                fi
                ;;
            '!')
                # "[rejected] (non-fast-forward)" -> "non-fast-forward"
                reason="$summary"
                if [[ "$summary" == *"("*")"* ]]; then
                    reason="${summary#*"("}"
                    reason="${reason%")"*}"
                fi
                printf 'Rejected: %s (%s)\n' "$name" "$reason"
                rejected=$(( rejected + 1 ))
                case "$reason" in
                    *non-fast-forward*|*"fetch first"*) diverged=$(( diverged + 1 )) ;;
                esac
                ;;
        esac
    done <<< "$out"

    # After a complete --prune push the remote holds exactly the local
    # archive, so tracking refs for anything else are stale too.
    if [[ $prune -eq 1 && $rc -eq 0 ]]; then
        for name in "${!tracked[@]}"; do
            if [[ -z "${local_sha[$name]:-}" ]]; then
                track_op["$name"]="delete ${remote_prefix}${name}"
            fi
        done
    fi

    if [[ -z "$dry_run" && ${#track_op[@]} -gt 0 ]]; then
        printf '%s\n' "${track_op[@]}" | git update-ref --stdin
    fi

    if [[ $(( pushed + deleted + rejected )) -eq 0 ]]; then
        [[ $rc -eq 0 ]] && printf 'Everything up to date.\n' || true
    else
        printf 'Done. Pushed %d ref(s)' "$pushed"
        [[ $deleted -gt 0 ]] && printf ', deleted %d' "$deleted" || true
        [[ $rejected -gt 0 ]] && printf ', %d rejected' "$rejected" || true
        printf '.\n'
    fi
    if [[ $diverged -gt 0 ]]; then
        # The remote copy is not an ancestor of the local one: re-archived
        # here at another commit, or changed on the remote since.
        printf 'Run "git arx fetch" to see which side changed; "git arx push --force" replaces the remote copies.\n'
    fi
    [[ -n "$dry_run" ]] && printf '(dry run – no changes written)\n' || true
    return "$rc"
}

cmd_fetch() {
    _arx_require_storage refs
    for arg in "$@"; do
        case "$arg" in
            *) printf 'git-arx: unknown option "%s"\n' "$arg" >&2; exit 1 ;;
        esac
    done
    local refsprefix="$ARX_REFSPREFIX"

    # A failed query aborts in _arx_ls_remote — degrading to an empty result
    # would make every archived branch look 'local' when the remote is simply
    # unreachable.
    declare -A remote_sha=()
    local ls_remote_out
    ls_remote_out=$(_arx_ls_remote) || exit 1
    while IFS=$'\t' read -r sha refname; do
        [[ -z "$sha" ]] && continue
        remote_sha["${refname#"$refsprefix"}"]="$sha"
    done <<< "$ls_remote_out"

    # Load local refs, and the tracking refs pull weighs them against: the
    # remote's state as of the last push or pull.
    declare -A local_sha=() base_sha=()
    local remote_prefix="$ARX_REMOTE_PREFIX"
    while IFS=' ' read -r refname sha _rest; do
        if [[ "$refname" == "$remote_prefix"* ]]; then
            base_sha["${refname#"$remote_prefix"}"]="$sha"
        else
            local_sha["${refname#"$refsprefix"}"]="$sha"
        fi
    done < <(git for-each-ref --format='%(refname) %(objectname)' "$refsprefix" "$remote_prefix" 2>/dev/null || true)

    # Union of all branch names
    declare -A all_branches=()
    for b in "${!remote_sha[@]}"; do all_branches["$b"]=1; done
    for b in "${!local_sha[@]}"; do all_branches["$b"]=1; done

    if [[ ${#all_branches[@]} -eq 0 ]]; then
        printf 'No archived branches.\n'
        return 0
    fi

    # Collect rows as tab-separated data for sorting
    # Same decision pull makes – see cmd_pull.
    local -a rows=()
    local branch r_sha l_sha b_sha display_sha status
    for branch in "${!all_branches[@]}"; do
        r_sha="${remote_sha[$branch]:-}"
        l_sha="${local_sha[$branch]:-}"
        b_sha="${base_sha[$branch]:-}"
        if [[ -n "$r_sha" && -z "$l_sha" ]]; then
            display_sha="${r_sha:0:8}"
            status="new"
        elif [[ -z "$r_sha" ]]; then
            display_sha="${l_sha:0:8}"
            status="local"
        elif [[ "$r_sha" == "$l_sha" ]]; then
            display_sha="${l_sha:0:8}"
            status="up to date"
        elif [[ "$r_sha" == "$b_sha" ]]; then
            display_sha="${l_sha:0:8}"
            status="ahead"        # re-archived here, not pushed yet
        elif [[ "$l_sha" == "$b_sha" ]]; then
            display_sha="${r_sha:0:8}"
            status="changed"      # changed on the remote only
        else
            display_sha="${r_sha:0:8}"
            status="conflict"     # changed on both sides
        fi
        rows+=("${branch}"$'\t'"${display_sha}"$'\t'"${status}")
    done

    local C_RED='' C_GREEN='' C_YELLOW='' C_DIM='' C_RESET=''
    if [[ -t 1 ]]; then
        C_RED=$'\033[31m' C_GREEN=$'\033[32m' C_YELLOW=$'\033[33m' C_DIM=$'\033[2m' C_RESET=$'\033[0m'
    fi

    printf '%-40s %-9s %s\n' "BRANCH" "SHA" "STATUS"
    printf '%-40s %-9s %s\n' "------" "---" "------"

    local colored_status
    while IFS=$'\t' read -r branch display_sha status; do
        case "$status" in
            "new")        colored_status="${C_GREEN}${status}${C_RESET}" ;;
            "up to date") colored_status="${C_DIM}${status}${C_RESET}" ;;
            "changed")    colored_status="${C_YELLOW}${status}${C_RESET}" ;;
            "ahead")      colored_status="${C_DIM}${status}${C_RESET}" ;;
            "conflict")   colored_status="${C_RED}${status}${C_RESET}" ;;
            "local")      colored_status="${C_DIM}${status}${C_RESET}" ;;
            *)            colored_status="$status" ;;
        esac
        printf '%-40s %-9s %s\n' "$branch" "$display_sha" "$colored_status"
    done < <(printf '%s\n' "${rows[@]}" | sort -t$'\t' -k1)
}

cmd_pull() {
    _arx_require_storage refs
    local refsprefix="$ARX_REFSPREFIX" remote_prefix="$ARX_REMOTE_PREFIX"

    # Snapshot before fetching: the local archive refs, and the tracking refs
    # – the remote's state as of the last push or pull. A local entry that no
    # longer matches its tracking ref was re-archived here since then, and
    # overwriting it with the remote's older copy would lose that commit for
    # good: refs/arx/* keeps no reflog.
    declare -A local_sha=() base_sha=()
    local refname sha name
    while IFS=' ' read -r refname sha; do
        if [[ "$refname" == "$remote_prefix"* ]]; then
            base_sha["${refname#"$remote_prefix"}"]="$sha"
        else
            local_sha["${refname#"$refsprefix"}"]="$sha"
        fi
    done < <(git for-each-ref --format='%(refname) %(objectname)' "$refsprefix" "$remote_prefix")

    # Fetch remote arx refs into the tracking namespace, then sync to local refs.
    # '+' allows non-fast-forward updates (after arx push --force on another
    # machine); --prune drops tracking refs whose remote counterpart is gone.
    git fetch --prune origin "+${refsprefix}*:${remote_prefix}*"

    # Take the remote's SHA where the local entry is missing or unchanged
    # since the last sync; keep the local one where only this side changed
    # (not pushed yet), and report it where both did. All updates go through
    # one update-ref transaction, each conditional on the local value seen
    # above.
    local -a updates=() kept=()
    local l b
    while IFS=' ' read -r refname sha; do
        name="${refname#"$remote_prefix"}"
        l="${local_sha[$name]:-}" b="${base_sha[$name]:-}"
        if [[ -z "$l" ]]; then
            updates+=("create ${refsprefix}${name} ${sha}")
        elif [[ "$l" == "$sha" || "$sha" == "$b" ]]; then
            :   # in sync, or re-archived here and not pushed yet
        elif [[ "$l" == "$b" ]]; then
            updates+=("update ${refsprefix}${name} ${sha} ${l}")
        else
            kept+=("$name (local: ${l:0:8}, remote: ${sha:0:8})")
        fi
    done < <(git for-each-ref --format='%(refname) %(objectname)' "$remote_prefix")
    if [[ ${#updates[@]} -gt 0 ]]; then
        printf '%s\n' "${updates[@]}" | git update-ref --stdin
    fi

    # If file backend is also enabled, sync fetched refs into .gitarchive
    if [[ "$ARX_STOREFILE" == "true" ]]; then
        _arx_refs_read | _arx_file_write_bulk
        printf 'Synced fetched refs to .gitarchive\n'
    fi

    if [[ ${#kept[@]} -gt 0 ]]; then
        printf 'Kept local (changed both here and on the remote since the last push or pull):\n'
        printf '  %s\n' "${kept[@]}"
        printf 'To keep both, rename the local entry ("git arx rename <branch> <new-name>") and pull again;\n'
        printf 'to replace the remote copy instead, run "git arx push --force".\n'
        exit 1
    fi
}

cmd_purge() {
    _arx_require_storage refs
    local dry_run=0 force=0
    for arg in "$@"; do
        case "$arg" in
            --dry-run|-n) dry_run=1 ;;
            --force|-f)   force=1 ;;
            *) printf 'git-arx: unknown option "%s"\n' "$arg" >&2; exit 1 ;;
        esac
    done
    local refsprefix="$ARX_REFSPREFIX" remote_prefix="$ARX_REMOTE_PREFIX"

    # Query the remote for every arx ref it holds – purge deletes all of them,
    # regardless of what the local archive contains. A failed query aborts in
    # _arx_ls_remote rather than being reported as 'No archived refs on the
    # remote.'
    local -a remote_refs=() branches=()
    local sha refname ls_remote_out
    ls_remote_out=$(_arx_ls_remote) || exit 1
    while IFS=$'\t' read -r sha refname; do
        [[ -z "$sha" ]] && continue
        remote_refs+=("$refname")
        branches+=("${refname#"$refsprefix"}")
    done <<< "$ls_remote_out"

    if [[ ${#remote_refs[@]} -eq 0 ]]; then
        printf 'No archived refs on the remote.\n'
        return 0
    fi

    printf 'The following archived refs will be deleted from the remote (origin):\n'
    local b
    for b in "${branches[@]}"; do
        printf '  %s\n' "$b"
    done
    printf '\n'

    if [[ $dry_run -eq 1 ]]; then
        printf 'Done. Deleted %d remote ref(s).\n' "${#remote_refs[@]}"
        printf '(dry run – no changes written)\n'
        return 0
    fi

    if [[ $force -eq 0 ]]; then
        printf 'NOTE: This deletes the remote copies of all archived refs.\n'
        printf 'Your local archive is not affected – re-publish anytime with git arx push.\n'
        printf 'Type "yes" to continue: '
        local answer
        read -r answer || true
        if [[ "$answer" != "yes" ]]; then
            printf 'Aborted.\n'
            exit 1
        fi
    fi

    # One push deletes every remote arx ref in a single round-trip.
    git push origin --delete "${remote_refs[@]}"

    # The remote now has no arx refs, so drop all local tracking refs to match
    # – in one update-ref transaction rather than a process per ref.
    git for-each-ref --format='delete %(refname)' "$remote_prefix" | git update-ref --stdin

    printf 'Done. Deleted %d remote ref(s).\n' "${#remote_refs[@]}"
}

cmd_upgrade() {
    local yes=0
    for arg in "$@"; do
        case "$arg" in
            -y|--yes) yes=1 ;;
            *) printf 'git-arx: unknown option "%s"\n' "$arg" >&2; exit 1 ;;
        esac
    done

    if [[ "$VERSION" == "dev" ]]; then
        printf 'git-arx: running from source (version: dev) – upgrade not applicable\n' >&2
        exit 1
    fi

    printf 'Checking for updates...\n'
    local latest
    latest=$(git ls-remote https://github.com/jurakovic/git-arx.git refs/heads/master 2>/dev/null | cut -f1 | cut -c1-7) || true
    if [[ -z "$latest" ]]; then
        printf 'git-arx: failed to fetch latest version (check your network connection)\n' >&2
        exit 1
    fi

    if [[ "$VERSION" == "$latest" ]]; then
        printf 'Already up to date (%s).\n' "$VERSION"
        return 0
    fi

    printf 'Current: %s\n' "$VERSION"
    printf 'Latest:  %s\n' "$latest"
    printf '\n'

    if [[ $yes -eq 0 ]]; then
        printf 'Install latest version? [y/N] '
        local answer
        read -r answer || true
        if [[ "$answer" != "y" && "$answer" != "Y" ]]; then
            printf 'Aborted.\n'
            exit 1
        fi
    fi

    local self install_dir
    self=$(command -v git-arx 2>/dev/null || true)
    if [[ -n "$self" ]]; then
        install_dir=$(dirname "$self")
        curl -fsSL https://raw.githubusercontent.com/jurakovic/git-arx/refs/heads/master/install.sh | bash -s -- "$install_dir"
    else
        curl -fsSL https://raw.githubusercontent.com/jurakovic/git-arx/refs/heads/master/install.sh | bash
    fi
}

cmd_help() {
    cat <<EOF
git-arx – Branch Archive Tool for Git (version: $VERSION)

Archive local git branches that have no remote tracking branch, preserving
the branch name and HEAD SHA for later inspection or restoration.

USAGE
  git arx <command> [options]

COMMANDS
  add <branch> [archive-name] [--force]  Archive a single branch
  remove|rm <branch>                     Remove a branch from the archive
  rename|mv <old> <new>                  Rename an archived branch
  status [-a|--all]                      Show local branches with deleted remote
         [--sort=name|date]              (--all also shows never-pushed branches)
         [--order=asc|desc]
  update [-f|--force] [-n|--dry-run]     Archive local branches with deleted remote
  list|ls [--sort=name|date]             List archived branches
       [--order=asc|desc]
       [--storage=file|refs]
       [--author]
  log <branch> [git-log-flags]           Show commits (delegates to git log)
  checkout <branch>                      Restore a branch from the archive
  prune [-f|--force] [-n|--dry-run]      Delete local branches whose commit is archived
  merge <f1> <f2> -o <out>               Merge two .gitarchive files       [file only]
  push [-f|--force] [-n|--dry-run]       Push archived refs to remote      [refs only]
       [--prune]                         Also delete remote refs not in local archive
       [--delete <branch>]               Delete a single archived ref from remote
  fetch                                  Preview what pull would bring in  [refs only]
  pull                                   Pull archived refs from remote    [refs only]
  purge [-f|--force] [-n|--dry-run]      Delete ALL archived refs from the [refs only]
                                         remote (local archive untouched)
  sync [-n|--dry-run]                    Reconcile file and refs backends  [file+refs]
       [--force-file]
       [--force-refs]
  upgrade [-y]                           Upgrade git-arx to the latest version
  help                                   Show this help
  --version, -v                          Show version

STORAGE BACKENDS
  Configured via two independent flags:
    git config arx.storerefs true|false   (default: true)
    git config arx.storefile true|false   (default: false)

  refs   Git refs under refs/arx/<branch>. Protects commits from gc.
         Enabled by default – archived commits remain reachable,
         preventing data loss if git gc runs after branch deletion.
         Never pushed to remote unless you run: git arx push
  file   Plain text .gitarchive file. Portable and committable.
         Enable for human-readable archives or team sharing via the repo.
         Commits may be lost after git gc if refs is also disabled.

OTHER CONFIG
  arx.filepath      Path to archive file (default: .gitarchive)
  arx.refsprefix    Refs namespace prefix (default: refs/arx/)

EXAMPLES
  git arx status
  git arx add feature/my-feature
  git arx add feature/my-feature --force
  git arx add feature/my-feature feature/my-feature-old
  git arx rename feature/my-feature feature/my-feature-v1
  git arx update
  git arx update --force
  git arx list --sort=date --order=desc
  git arx log feature/my-feature --oneline -10
  git arx checkout feature/my-feature
  git arx sync --dry-run
  git arx push
  git arx push --delete feature/my-feature
  git arx push --prune
  git arx pull
  git arx purge

EOF
}

# --- ENTRY POINT -------------------------------------------------------------

main() {
    local cmd="${1:-}"
    shift || true

    case "$cmd" in
        --version|-v) printf 'git-arx %s\n' "$VERSION"; return 0 ;;
        help|-h)      cmd_help; return 0 ;;
        upgrade)      cmd_upgrade "$@"; return 0 ;;
    esac

    _arx_require_git    # sets ARX_GIT_ROOT
    _arx_load_config

    case "$cmd" in
        add)      cmd_add "$@" ;;
        remove|rm) cmd_remove "$@" ;;
        rename|mv) cmd_rename "$@" ;;
        status)    cmd_status "$@" ;;
        update)    cmd_update "$@" ;;
        list|ls)   cmd_list "$@" ;;
        log)      cmd_log "$@" ;;
        checkout) cmd_checkout "$@" ;;
        prune)    cmd_prune "$@" ;;
        merge)    cmd_merge "$@" ;;
        push)     cmd_push "$@" ;;
        fetch)    cmd_fetch "$@" ;;
        pull)     cmd_pull "$@" ;;
        purge)    cmd_purge "$@" ;;
        sync)     cmd_sync "$@" ;;
        "")       cmd_help; exit 1 ;;
        *)
            printf 'git-arx: unknown command "%s"\n' "$cmd" >&2
            printf 'Run "git arx help" for usage.\n' >&2
            exit 1
            ;;
    esac
}

# Braces force bash to parse this entire block (through the exit) before
# executing it, and exit ends the process without reading the file again.
# Without this, `upgrade` overwriting the running script mid-execution makes
# bash resume reading the replaced file at a stale byte offset and parse
# whatever bytes it lands on.
{ main "$@"; exit; }
